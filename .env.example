# Pulse environment — copy to .env and fill in. Defaults match docker-compose.yml
# for local development. Never commit a real .env (it is gitignored).

# ---- Core ------------------------------------------------------------------
NODE_ENV=development
# API server listen port.
PORT=8080
# Log verbosity (pino): trace|debug|info|warn|error.
LOG_LEVEL=info

# ---- Database (Postgres) ---------------------------------------------------
DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse
# Optional: PGSSLMODE=require for managed Postgres that enforces TLS.

# ---- Object storage (S3-compatible) ----------------------------------------
# For local dev (docker-compose s3mock), keep the endpoint + path-style below;
# any access key/secret is accepted. For real AWS S3, unset S3_ENDPOINT and
# S3_FORCE_PATH_STYLE and use an IAM role or real keys.
S3_BUCKET=pulse-artifacts
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9090
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=pulse
S3_SECRET_ACCESS_KEY=pulse-dev-secret

# ---- LLM (Anthropic, via the PII-stripping gateway) ------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional: point at a self-hosted proxy/gateway instead of the public API.
# ANTHROPIC_BASE_URL=

# ---- Auth (Clerk) ----------------------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_test_your-key
CLERK_SECRET_KEY=sk_test_your-key
# Optional: pin the JWT verification key; advanced Clerk proxy/satellite vars
# (CLERK_PROXY_URL, CLERK_DOMAIN, CLERK_IS_SATELLITE, …) are only needed for
# custom Clerk deployments.
# CLERK_JWT_KEY=

# ---- Crypto / secrets ------------------------------------------------------
# Root secret used to derive the connector-token encryption key and to sign
# exports. REQUIRED in production (dev has a fallback). Use a long random value.
SESSION_SECRET=dev-only-change-me-to-a-long-random-string
# Optional explicit overrides (otherwise derived from SESSION_SECRET):
# PULSE_TOKEN_KEY=
# PULSE_EXPORT_KEY=
# Optional KMS-style key rotation:
# PULSE_KMS_KEYS=
# PULSE_KMS_ACTIVE_REF=
# PULSE_ROOT_KEY=

# ---- App behavior ----------------------------------------------------------
# Browser origin(s) allowed for credentialed CORS (comma-separated). localhost
# dev ports are always allowed.
PULSE_WEB_ORIGIN=http://localhost:5173
# Comma-separated emails granted admin access.
PULSE_ADMIN_EMAILS=
# Optional: magic-link survey invite TTL in ms (default 30 days).
# PULSE_INVITE_TTL_MS=

# ---- Frontend (pulse vite) -------------------------------------------------
# The web app is run separately: PORT=5173 BASE_PATH=/ pnpm --filter @workspace/pulse dev
# BASE_PATH is the app's base path ("/" for root deployments).
