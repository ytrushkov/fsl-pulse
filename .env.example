# =============================================================================
# Pulse — Environment Variable Reference
# =============================================================================
# Copy this file to .env (never commit .env).
# In production, ALL secrets come from AWS Parameter Store / KMS — never from
# a .env file.  The local .env is strictly for developer workstations and
# Docker Compose dev stacks.
#
# Obtaining values:
#   - AWS secrets → run: aws ssm get-parameter --name <PARAMETER_PATH> --with-decryption
#   - Google OAuth → Google Cloud Console → APIs & Services → Credentials
#   - Anthropic API → https://console.anthropic.com → API Keys
#   - Local generated values → see each section's instructions
# =============================================================================


# -----------------------------------------------------------------------------
# APP CONFIG
# -----------------------------------------------------------------------------

# Environment tag. Controls debug mode, HTTPS redirects, and CORS strictness.
# Values: local | staging | production
APP_ENV=local

# Public base URL of the application (no trailing slash).
# Used for magic-link construction, CORS origin allowlist, and cookie domain.
APP_BASE_URL=http://localhost:3000

# Internal FastAPI origin (used by Next.js -> API calls inside Docker network).
# In production this is the private ALB DNS name.
API_INTERNAL_URL=http://api:8000

# Log level for the backend. Values: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Never use DEBUG in production — it may emit request bodies.
LOG_LEVEL=INFO

# Secret used to sign internal service-to-service JWTs (not user-facing JWTs).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_SERVICE_SECRET=REPLACE_WITH_64_HEX_CHARS


# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL 16
# -----------------------------------------------------------------------------

# Full DSN used by SQLAlchemy async engine. In production, this is constructed
# at runtime from Parameter Store values; it is never hardcoded.
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://pulse:REPLACE_WITH_STRONG_PASSWORD@db:5432/pulse_dev

# Individual components used by Alembic CLI and docker-compose health checks.
POSTGRES_USER=pulse
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=pulse_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Test database URL — used by pytest integration tests against the local docker-compose DB.
# Must contain "pulse_test" (safety guard prevents accidental production use).
# Format: postgresql+asyncpg://user:password@localhost:5433/pulse_test
TEST_DATABASE_URL=postgresql+asyncpg://pulse:REPLACE_WITH_STRONG_PASSWORD@localhost:5433/pulse_test

# Connection pool sizing. Keep small in dev; tune up for production.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30


# -----------------------------------------------------------------------------
# REDIS 7 — Cache, task broker, rate-limit counters
# -----------------------------------------------------------------------------

# Full Redis URL. In production use TLS scheme: rediss://
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0

# Redis password (matches the requirepass directive in redis.conf).
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# Separate DB index for rate-limit counters so a FLUSHDB in tests does not
# clear application cache.
REDIS_RATE_LIMIT_DB=1


# -----------------------------------------------------------------------------
# S3 / MINIO — Artifact and evidence storage
# -----------------------------------------------------------------------------

# In dev, MinIO runs as a Docker service that speaks the S3 API.
# In production, the ECS task role provides credentials via the instance
# metadata endpoint — AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are not set
# in production; leave them blank there.

S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET_ARTIFACTS=pulse-artifacts
S3_BUCKET_EXPORTS=pulse-exports

# Local dev only. Remove / leave blank in production (use IAM task role).
AWS_ACCESS_KEY_ID=REPLACE_WITH_MINIO_ROOT_USER
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_MINIO_ROOT_PASSWORD

# MinIO admin credentials (local dev only, separate from application credentials).
MINIO_ROOT_USER=REPLACE_WITH_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_MINIO_ROOT_PASSWORD


# -----------------------------------------------------------------------------
# TEMPORAL — Workflow orchestration
# -----------------------------------------------------------------------------

# Temporal server address (gRPC). In production use the mTLS Temporal Cloud endpoint.
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=pulse
TEMPORAL_TASK_QUEUE=pulse-workers

# mTLS certificate paths for Temporal Cloud (production only; leave blank in dev).
# These files must NOT be committed — they are covered by .gitignore *.pem / *.key.
TEMPORAL_TLS_CERT_PATH=
TEMPORAL_TLS_KEY_PATH=


# -----------------------------------------------------------------------------
# ANTHROPIC API — LLM Gateway
# -----------------------------------------------------------------------------

# API key from https://console.anthropic.com -> API Keys.
# This value is accessed EXCLUSIVELY through packages/llm-gateway.
# It must NEVER be imported directly in application or connector code.
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY

# Model IDs. Override per-call when needed.
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
ANTHROPIC_MODEL_OPUS=claude-opus-4-5
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5

# Hard cap on tokens per LLM request (cost guard).
ANTHROPIC_MAX_TOKENS=8192

# Per-request timeout in seconds.
ANTHROPIC_REQUEST_TIMEOUT_SECONDS=120


# -----------------------------------------------------------------------------
# GOOGLE OAUTH (OIDC) — SSO via Google Workspace
# -----------------------------------------------------------------------------

# Credentials from Google Cloud Console -> APIs & Services -> OAuth 2.0 Client IDs.
# Application type: Web application.
# Authorized redirect URI must include: <APP_BASE_URL>/auth/callback
GOOGLE_CLIENT_ID=REPLACE_WITH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# Restrict login to a single Google Workspace domain. Enforcement happens
# server-side in the OIDC callback handler — never rely on the IdP alone.
# Leave blank to allow any Google account (not appropriate for production).
GOOGLE_ALLOWED_DOMAIN=fullstacklabs.co

# Standard OIDC discovery URL (do not change unless proxying through a custom IdP).
GOOGLE_OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration


# -----------------------------------------------------------------------------
# AUTH / SESSION
# -----------------------------------------------------------------------------

# Secret for signing HTTP-only session cookies. Minimum 32 random bytes.
# Generate: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
SESSION_SECRET_KEY=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES

# Cookie attributes. In production: COOKIE_SECURE=true, COOKIE_SAMESITE=lax.
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax
# Max age in seconds. Default 8 hours (one working session).
COOKIE_MAX_AGE_SECONDS=28800

# Magic-link token TTL in seconds (survey invitation links). Default 7 days.
MAGIC_LINK_TTL_SECONDS=604800

# HMAC secret used to sign magic-link tokens. Only the HMAC hash is persisted;
# the raw token is sent once to the respondent and never stored.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
MAGIC_LINK_SIGNING_SECRET=REPLACE_WITH_64_HEX_CHARS

# JWT algorithm for internal tokens. Use RS256 (asymmetric) in all environments.
# HS256 is prohibited because it requires sharing the signing secret.
JWT_ALGORITHM=RS256

# Paths to RSA-2048 key pair used for JWT signing.
# Generate:
#   openssl genrsa -out secrets/jwt_private.pem 2048
#   openssl rsa -in secrets/jwt_private.pem -pubout -out secrets/jwt_public.pem
# The secrets/ directory is covered by .gitignore — never commit key files.
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem


# -----------------------------------------------------------------------------
# AWS KMS — Secrets vault (production)
# -----------------------------------------------------------------------------

# KMS key ARN used to encrypt Parameter Store SecureString values.
# The ECS task role must have kms:Decrypt on this key. Leave blank in local dev
# (the SecretsManager service falls back to environment variables when ARN is absent).
AWS_KMS_KEY_ARN=arn:aws:kms:us-east-1:ACCOUNT_ID:key/REPLACE_WITH_KEY_ID

# Parameter Store path prefix. All connector credentials are stored under this path.
# Convention: <PREFIX>/connectors/<engagement_id>/<connector_type>/token
AWS_PARAMETER_STORE_PREFIX=/pulse/local

# AWS region for KMS and Parameter Store. Must match the KMS key region.
AWS_REGION=us-east-1

# AWS account ID (used for ARN validation; not a secret but captured here for
# consistency — do not commit actual account IDs in public repositories).
AWS_ACCOUNT_ID=REPLACE_WITH_12_DIGIT_ACCOUNT_ID


# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------

# Requests per minute per IP for unauthenticated endpoints (e.g., magic-link redemption).
RATE_LIMIT_ANON_RPM=20

# Requests per minute per authenticated user session.
RATE_LIMIT_AUTH_RPM=300

# Requests per minute per IP for magic-link generation (anti-enumeration / anti-spam).
RATE_LIMIT_MAGIC_LINK_RPM=5


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

# Comma-separated list of allowed origins. Must be explicit — wildcard "*" is
# prohibited because credentials (cookies) must be allowed.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Must be true to allow the browser to send the session cookie cross-origin.
CORS_ALLOW_CREDENTIALS=true


# -----------------------------------------------------------------------------
# AUDIT LOG
# -----------------------------------------------------------------------------

# Retention window in days. SOC 2 Type II requires a minimum of 90 days.
AUDIT_LOG_RETENTION_DAYS=90


# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------

# Set to false to disable all Anthropic API calls (useful for offline dev / CI).
FEATURE_LLM_ENABLED=true

# Minimum number of survey respondents per team before aggregate data is surfaced
# in the UI. Enforced at the query layer, not just the presentation layer.
SURVEY_ANONYMITY_FLOOR=5
